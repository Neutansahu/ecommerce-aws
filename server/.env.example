# Only for running the API on your own PC. On AWS these values come from
# Secrets Manager and the CloudFormation stack, so never commit a real .env.
PORT=3000
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=ecommerce
JWT_SECRET=change-this-to-a-long-random-text
S3_BUCKET=
AWS_REGION=ap-south-1
SITE_URL=http://localhost:5173
# Email (Amazon SES). Leave SES_FROM empty to turn emails off.
SES_FROM=
ADMIN_EMAIL=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
